*.iml
.gradle
.kotlin
/local.properties
/.idea
.DS_Store
/build
/app/build
/macrobenchmark/build
/captures
.externalNativeBuild
.cxx

# APKs are built locally and never versioned.
*.apk

# Device logs and captures: they may carry the dash Wi-Fi name, positions or account data. NEVER commit.
*.log
/logs/
/captures/
# Recordings of a ride (the dash's video, Android Auto's stream): they show the route and what was on the screen.
*.h264
*.aasession

# Signing material: the release key and its secrets are never in the repository.
signing.properties
*.jks
*.keystore
segredos.env
reau_chave/

# Python bytecode.
__pycache__/

# The frame decoder compiled on this machine (it links the system's libavcodec, so it only runs here): the source, dec5.c, is
# versioned and the test builds the program when it needs it. Old builds kept beside it are not versioned either.
/scripts/dev/teste_cego/dec5
/scripts/dev/teste_cego/arquivo/

# Output of scripts/emu (test runs, screenshots).
/emu_out/

# APK bundles are never versioned either.
*.apkm
*.xapk
*.aab

# Keys and certificates are never versioned (the project's signing key lives outside the repository).
*.p12
*.pem
*.pfx

# The stub of Android Auto that scripts/emu builds for the emulator (an APK, already covered by *.apk; named here on purpose).
/scripts/emu/stub_android_auto/build/

# Zips (a pack of APKs, a log export), performance traces and memory dumps carry the phone's data or the signed builds: never versioned.
*.zip
*.pftrace
*.perfetto-trace
*.hprof

# What a Jazzer fuzzing run leaves in the module folder (JAZZER_FUZZ=1, see CONTRIBUTING): its working corpus and the inputs that crashed.
# A crash input worth keeping goes into app/src/test/resources/.../ParserFuzzTargetsInputs/<target>/ by hand.
/app/.cifuzz-corpus/
/app/crash-*
/app/slow-unit-*
/app/oom-*
/app/timeout-*

# The bench panel's log and video (scripts/painel_falso): they may hold what the phone sent.
painel_falso_saida/
