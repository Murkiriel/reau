<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Opening any socket needs this, loopback included: the UDP link to the dash (192.168.1.x, no internet there)
         and the TCP link to Android Auto on 127.0.0.1. Only the optional weather query goes online. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Joining the dash's own Wi-Fi (WifiNetworkSpecifier + ConnectivityManager.requestNetwork) and finding it in
         the scan results. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Reading the Wi-Fi list (WifiManager.startScan/getScanResults), to learn the dash's whole name, needs the fine
         location on every Android, and Android wants the coarse one asked with it; the nearby-devices permission does
         not open that list (Android's docs, and a test on Android 14), so it was removed. The
         position itself is read only with the switch "Usar a localização" on, for the theme by the sun. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- The projection's foreground service (ProjectionService): it keeps the CPU (wake lock) and the Wi-Fi (Wi-Fi
         lock) awake with the screen off. "Connected device" is its type: the dash is one. The notification shows
         where the projection stands and has the switch-off button; from Android 13 it needs the rider's consent. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The joystick answers and ends calls, behind a switch (asked when switched on). -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Gemini by the joystick, behind a switch (asked when switched on). The voice goes
         to Android Auto from the Bluetooth headset (choosing it needs MODIFY_AUDIO_SETTINGS) or the phone; the
         projection's service then also has the microphone type, or Android hands it silence in the background. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Android's dialog to leave REau out of battery optimization (the projection with the screen off). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Reading which Android Auto is installed (its version goes in the diagnostics log). Without this entry
         Android 11+ answers "no such package" for any app this one does not otherwise see. -->
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
        <!-- The store app and the browser that can show Android Auto's page, when it is not installed (market: first, then https:). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- The car apps for navigation installed, to name the one Android Auto shows on the dash. -->
        <intent>
            <action android:name="androidx.car.app.CarAppService" />
        </intent>
    </queries>

    <!-- Backups disabled: the app will hold the dash Wi-Fi name and password, which identify one bike. -->
    <application
        android:name=".REauApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.REau">

        <!-- The language is changed on the settings: the screen is told and redraws its texts, it is not destroyed and rebuilt (that
             showed as a flash). A Compose screen reads its strings again on the change. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="locale|layoutDirection"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.ProjectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|microphone" />
        <!-- The logs zip handed to the app the rider picks in the share sheet. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
