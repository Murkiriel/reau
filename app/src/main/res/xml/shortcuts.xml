<?xml version="1.0" encoding="utf-8"?>
<!-- A long press on the icon: switches the projection on (see QuickStart). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="quick_start"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/quick_start_label"
        android:shortcutLongLabel="@string/quick_start_long_label">
        <intent
            android:action="com.reau.app.QUICK_START"
            android:targetPackage="com.reau.app"
            android:targetClass="com.reau.app.MainActivity" />
    </shortcut>
</shortcuts>
